<launch>
  <!-- Compatibility alias. New callers should use full_competition.launch. -->
  <arg name="start_gazebo" default="true"/>
  <arg name="gazebo_gui" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="use_nvidia_gpu" default="true"/>
  <arg name="start_navigation_server" default="true"/>
  <arg name="navigation_action_name"
       default="/smart_factory/navigation"/>
  <arg name="navigation_server_wait_timeout" default="10.0"/>
  <arg name="navigation_config"
       default="$(find smart_factory_navigation)/config/navigation.yaml"/>
  <arg name="fitted_path_config"
       default="$(find smart_factory_navigation)/config/pickup_staging_fitted_path.yaml"/>
  <arg name="move_base_action" default="/move_base"/>
  <!-- The former entry point did not start perception; preserve that behavior. -->
  <arg name="start_perception" default="false"/>
  <arg name="mission_config"
       default="$(find smart_factory_mission)/config/mission.yaml"/>
  <arg name="goal_config"
       default="$(find smart_factory_mission)/config/pickup_staging_dev.yaml"/>

  <include file="$(find smart_factory_bringup)/launch/full_competition.launch">
    <arg name="start_gazebo" value="$(arg start_gazebo)"/>
    <arg name="gazebo_gui" value="$(arg gazebo_gui)"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="use_nvidia_gpu" value="$(arg use_nvidia_gpu)"/>
    <arg name="start_navigation_server"
         value="$(arg start_navigation_server)"/>
    <arg name="navigation_action_name"
         value="$(arg navigation_action_name)"/>
    <arg name="navigation_server_wait_timeout"
         value="$(arg navigation_server_wait_timeout)"/>
    <arg name="navigation_config" value="$(arg navigation_config)"/>
    <arg name="fitted_path_config" value="$(arg fitted_path_config)"/>
    <arg name="move_base_action" value="$(arg move_base_action)"/>
    <arg name="start_perception" value="$(arg start_perception)"/>
    <arg name="mission_config" value="$(arg mission_config)"/>
    <arg name="goal_config" value="$(arg goal_config)"/>
  </include>
</launch>
