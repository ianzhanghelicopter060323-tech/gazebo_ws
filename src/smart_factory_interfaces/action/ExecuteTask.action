# External task goal. The vehicle sends the task identity and target class,
# never a Gazebo/world coordinate.
uint8 FOOD=0
uint8 DAILY=1
uint8 ELECTRONICS=2

string task_id
uint8 target_class
---
# Final result. The complete pipeline ends after workshop release.
uint8 STAGE_NONE=0
uint8 STAGE_ARRIVED_PICKUP_STAGING=6
uint8 STAGE_OBJECT_GRASPED=14
uint8 STAGE_GET_DELIVERY_GOAL=15
uint8 STAGE_NAVIGATE_TO_DELIVERY=16
uint8 STAGE_ARRIVED_DELIVERY=17
uint8 STAGE_RELEASE_OBJECT=18
uint8 STAGE_TASK_COMPLETED=20

bool success
uint8 completed_stage
uint8 error_code
string message
---
# Long-running task feedback.
uint8 STAGE_IDLE=0
uint8 STAGE_ACCEPT_TASK=1
uint8 STAGE_VALIDATE_TASK=2
uint8 STAGE_CHECK_LOCALIZATION=3
uint8 STAGE_GET_PICKUP_STAGING_GOAL=4
uint8 STAGE_NAVIGATE_TO_PICKUP_STAGING=5
uint8 STAGE_ARRIVED_PICKUP_STAGING=6
uint8 STAGE_OBSERVE_PICKUP_CANDIDATE=7
uint8 STAGE_NAVIGATE_TO_PICKUP_CANDIDATE=8
uint8 STAGE_LOCALIZE_TARGET=9
uint8 STAGE_ALIGN_FOR_GRASP=10
uint8 STAGE_OPEN_GRIPPER=11
uint8 STAGE_GRASP_OBJECT=12
uint8 STAGE_VERIFY_GRASP=13
uint8 STAGE_OBJECT_GRASPED=14
uint8 STAGE_GET_DELIVERY_GOAL=15
uint8 STAGE_NAVIGATE_TO_DELIVERY=16
uint8 STAGE_ARRIVED_DELIVERY=17
uint8 STAGE_RELEASE_OBJECT=18
uint8 STAGE_TASK_COMPLETED=20
uint8 STAGE_TASK_FAILED=250

uint8 current_stage
uint8 retry_count
string detail
